// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  role          UserRole  @default(FREE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  agents        AgentSession[]
  subscriptions Subscription[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserRole {
  FREE
  DEVELOPER_PRO
  ARCHITECTURE_PRO
  EDI_PROFESSIONAL
  ENTERPRISE
  ADMIN
}

// ============================================================
// SUBSCRIPTION
// ============================================================

model Subscription {
  id               String             @id @default(cuid())
  userId           String
  stripeCustomerId String?            @unique
  stripePriceId    String?
  stripeSubId      String?            @unique
  plan             UserRole
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  INCOMPLETE
}

// ============================================================
// PROJECTS
// ============================================================

model Project {
  id          String        @id @default(cuid())
  userId      String
  name        String
  description String?
  workspace   WorkspaceType
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ediMaps     EdiMap[]
  aiChats     AIChat[]
  
  @@index([userId])
}

enum WorkspaceType {
  DEVELOPER
  ARCHITECTURE
  EDI
}

// ============================================================
// EDI
// ============================================================

model EdiMap {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  description String?
  sourceFormat EdiFormat
  targetFormat EdiFormat
  mapContent  Json?
  status      EdiStatus @default(DRAFT)
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCases  EdiTestCase[]
  deployments EdiDeployment[]

  @@index([projectId])
}

enum EdiFormat {
  X12
  EDIFACT
  CSV
  FLAT_FILE
  JSON
  XML
  SAP_IDOC
  HL7
  API_PAYLOAD
  DATABASE
  MQ
  KAFKA
}

enum EdiStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  DEPRECATED
}

model EdiTestCase {
  id         String   @id @default(cuid())
  mapId      String
  name       String
  inputData  String   @db.Text
  expected   String   @db.Text
  result     String?  @db.Text
  passed     Boolean?
  createdAt  DateTime @default(now())

  map EdiMap @relation(fields: [mapId], references: [id], onDelete: Cascade)

  @@index([mapId])
}

model EdiDeployment {
  id          String           @id @default(cuid())
  mapId       String
  environment DeployEnvironment
  status      DeployStatus     @default(PENDING)
  deployedAt  DateTime?
  createdAt   DateTime         @default(now())

  map EdiMap @relation(fields: [mapId], references: [id], onDelete: Cascade)

  @@index([mapId])
}

enum DeployEnvironment {
  DEV
  STAGING
  PRODUCTION
}

enum DeployStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  ROLLED_BACK
}

// ============================================================
// AI AGENTS
// ============================================================

model AgentSession {
  id        String      @id @default(cuid())
  userId    String
  agentType AgentType
  name      String
  memory    Json?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AgentMessage[]

  @@index([userId])
}

enum AgentType {
  DEVELOPER
  ARCHITECTURE
  EDI_MAPPING
  DOCUMENTATION
  TESTING
  DEPLOYMENT
  OPTIMIZATION
  TRAINING
}

model AgentMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String   // "user" | "assistant" | "system"
  content   String   @db.Text
  tokens    Int?
  createdAt DateTime @default(now())

  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model AIChat {
  id        String   @id @default(cuid())
  projectId String
  model     String
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ============================================================
// PLUGINS
// ============================================================

model Plugin {
  id          String      @id @default(cuid())
  name        String
  description String?
  version     String
  author      String?
  category    PluginCategory
  icon        String?
  isVerified  Boolean     @default(false)
  downloads   Int         @default(0)
  rating      Float?
  createdAt   DateTime    @default(now())

  @@index([category])
}

enum PluginCategory {
  AI_MODELS
  VCS
  CI_CD
  CLOUD
  DATABASE
  COMMUNICATION
  EDI
  BIM
  TESTING
  MONITORING
}
